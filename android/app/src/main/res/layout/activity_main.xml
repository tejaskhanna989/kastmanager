<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kast_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Kast Manager"
        android:textAppearance="@style/KastBigValue"
        android:textSize="20sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/page_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/KastCard"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU" />
                    <TextView android:id="@+id/dash_cpu"
                        style="@style/KastBigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="…" />
                    <TextView android:id="@+id/dash_cpu_sub"
                        style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />
                </LinearLayout>

                <LinearLayout style="@style/KastCard"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memory" />
                    <TextView android:id="@+id/dash_mem"
                        style="@style/KastBigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="…" />
                    <TextView android:id="@+id/dash_mem_sub"
                        style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />
                </LinearLayout>

                <LinearLayout style="@style/KastCard"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage" />
                    <TextView android:id="@+id/dash_storage"
                        style="@style/KastBigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="…" />
                    <TextView android:id="@+id/dash_storage_sub"
                        style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />
                </LinearLayout>

                <LinearLayout style="@style/KastCard"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Battery" />
                    <TextView android:id="@+id/dash_batt"
                        style="@style/KastBigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="…" />
                    <TextView android:id="@+id/dash_batt_sub"
                        style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />
                </LinearLayout>

                <LinearLayout style="@style/KastCard"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView style="@style/KastCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uptime" />
                    <TextView android:id="@+id/dash_uptime"
                        style="@style/KastBigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="…" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/page_processes"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/proc_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh" />

            <ListView
                android:id="@+id/proc_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#14FFFFFF"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/page_system"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/sys_rows"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <ScrollView
            android:id="@+id/page_about"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone"
            android:clipToPadding="false">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kast Manager 2.8.0"
                    android:textAppearance="@style/KastBigValue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Fresh minimal system companion by Tejas Khanna. GPL-3.0-or-later."
                    style="@style/KastCaption" />

                <Button
                    android:id="@+id/about_github"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="GitHub" />

                <Button
                    android:id="@+id/about_donate_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Donate (India)" />

                <Button
                    android:id="@+id/about_donate_out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Donate (outside India)" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
